          "name": "Execute Checkout (Paystack)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Checkout Executed', () => {",
                  "  pm.response.to.have.status(201);",
                  "  const res = pm.response.json();",
                  "  if (res.order && res.order.id) {",
                  "    pm.collectionVariables.set('orderId', res.order.id);",
                  "  }",
                  "  if (res.paymentIntent && res.paymentIntent.id) {",
                  "    pm.collectionVariables.set('paymentIntentId', res.paymentIntent.id);",
                  "  }",
                  "  if (res.paymentIntent && res.paymentIntent.provider_ref) {",
                  "    pm.collectionVariables.set('paymentReference', res.paymentIntent.provider_ref);",
                  "  }",
                  "  if (res.checkoutUrl) {",
                  "    pm.collectionVariables.set('checkoutUrl', res.checkoutUrl);",
                  "    console.log('Open this URL in your browser to complete payment:', res.checkoutUrl);",
                  "  }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
