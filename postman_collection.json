    {
      "name": "Auth",
      "item": [
        {
          "name": "Register Customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Customer Registered', () => {",
                  "  pm.response.to.have.status(201);",
                  "  const res = pm.response.json();",
                  "  if (res.user && res.user.id) {",
                  "    pm.collectionVariables.set('userId', res.user.id);",
                  "    pm.collectionVariables.set('customerId', res.user.customerId);",
                  "  }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer_{{$timestamp}}@example.com\",\n  \"password\": \"Password123!\",\n  \"name\": \"Jane Shopper\",\n  \"role\": \"customer\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Login Customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login Successful & Token Saved', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const res = pm.response.json();",
                  "  pm.expect(res.accessToken).to.be.a('string');",
                  "  pm.collectionVariables.set('token', res.accessToken);",
                  "  if (res.user) {",
                  "    pm.collectionVariables.set('userId', res.user.id);",
                  "    pm.collectionVariables.set('customerId', res.user.customerId);",
                  "  }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
