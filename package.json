{
  "name": "agent-operable-commerce-backend",
  "version": "1.0.0",
  "description": "Agent-operable commerce backend on Ductape with modular monolith architecture",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "prestart": "npm run build",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run --exclude '**/tests/real/**'",
    "test:live": "vitest run tests/real",
    "test:all": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "ductape",
    "commerce",
    "modular-monolith",
    "mcp",
    "paystack"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@ductape/sdk": "^0.3.9",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/localtunnel": "^2.0.4",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "localtunnel": "^2.0.2",
    "pg-mem": "^3.0.14",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
